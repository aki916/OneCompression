{
  "model": "Qwen/Qwen3-8B",
  "backend": "transformers",
  "device": "cuda",
  "dtype": "bfloat16",
  "quantization": "none",
  "dataset_path": "experiments/reasoning_compression/data/math500.jsonl",
  "split": "development",
  "limit": 12,
  "seed": 0,
  "max_new_tokens": 16000,
  "oracle_max_boundaries": 32,
  "oracle_probe_signals": true,
  "oracle_attention": true,
  "oracle_policy": {"policy": "asag_reference", "boundary": "tokens", "interval": 256}
}
