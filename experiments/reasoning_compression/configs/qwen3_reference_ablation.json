{
  "model": "Qwen/Qwen3-8B",
  "backend": "transformers",
  "device": "cuda",
  "dtype": "bfloat16",
  "quantization": "none",
  "dataset_path": "experiments/reasoning_compression/data/math500.jsonl",
  "split": "development",
  "limit": 50,
  "seed": 0,
  "max_new_tokens": 16000,
  "warmup_requests": 1,
  "policies": [
    {"policy": "none"},
    {"policy": "fixed", "budget": 256},
    {"policy": "fixed", "budget": 512},
    {"policy": "fixed", "budget": 1024},
    {"policy": "fixed", "budget": 2048},
    {"policy": "fixed", "budget": 4096},
    {"policy": "fixed", "budget": 8192},
    {"policy": "prompt_budget"},
    {"policy": "thinkbrake", "threshold": 0.05, "temperature": 0.6},
    {"policy": "thinkbrake", "threshold": 0.1, "temperature": 0.6},
    {"policy": "thinkbrake", "threshold": 0.3, "temperature": 0.6},
    {"policy": "deer", "confidence_threshold": 0.9, "boundary": "transition"},
    {"policy": "deer", "confidence_threshold": 0.95, "boundary": "transition"},
    {"policy": "deer", "confidence_threshold": 0.99, "boundary": "transition"},
    {"policy": "stability", "boundary": "tokens", "interval": 256, "stability_window": 3},
    {"policy": "asag_reference", "boundary": "transition", "asag_mode": "confidence"},
    {"policy": "asag_reference", "boundary": "transition", "asag_mode": "attention"},
    {"policy": "asag_reference", "boundary": "transition", "asag_mode": "both"},
    {"policy": "asag_reference", "boundary": "transition", "enable_injection": false},
    {"policy": "asag_reference", "boundary": "transition", "enable_trap": false},
    {"policy": "asag_reference", "boundary": "transition"},
    {"policy": "asag_reference", "boundary": "transition", "entropy_threshold": -0.05},
    {"policy": "asag_reference", "boundary": "transition", "entropy_threshold": -0.2},
    {"policy": "progressive", "boundary": "tokens", "interval": 256, "asag_mode": "confidence"},
    {"policy": "progressive", "boundary": "tokens", "interval": 256},
    {"policy": "progressive", "boundary": "tokens", "interval": 256, "confidence_threshold": 0.99}
  ]
}
